# Copy this file to .env and replace every password before starting the stack.
# Never commit .env.

# Docker Hub account that owns the Moderation and Discord DMs images. Note it is not
# the GitHub account name: the images live under meow3r.
DOCKERHUB_USER=meow3r
# Fill with the reviewed registration-enabled release (owner reported lab3-0.3.1).
MODERATION_VERSION=lab3-0.4.0
MODERATION_DB_NAME=moderation
MODERATION_DB_USER=moderation
MODERATION_DB_PASSWORD=change-me
# Fill with the reviewed registration-enabled Redis release (owner reported lab3-0.3.0).
DMS_VERSION=lab3-0.4.1
DMS_REDIS_PASSWORD=change-me

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
CREDENTIAL_DB_NAME=credential_db
CREDENTIAL_DB_USER=credential_user
CREDENTIAL_DB_PASSWORD=change-me
RULES_DB_NAME=rules_db
RULES_DB_USER=rules_user
RULES_DB_PASSWORD=change-me
CREDENTIAL_IMAGE=cmmarin/student-id-credential-service:lab3-0.4.0
RULES_IMAGE=cmmarin/student-id-rules-service:lab3-0.4.0

PLAYER_IMAGE=vasiok11/student-id-player-service:lab3-0.4.0-build.10
PLAYER_DB_NAME=player
PLAYER_DB_USER=player
PLAYER_DB_PASSWORD=change-me

# Fill after the distributed-SSE Session candidate publishes from reviewed main.
SESSION_IMAGE=vasiok11/student-id-session-service:lab3-0.5.0-build.14
SESSION_DB_NAME=session
SESSION_DB_USER=session
SESSION_DB_PASSWORD=change-me

APPLICANT_IMAGE=andreiisthebest/student-id-applicant-service:lab3-0.3.0
APPLICANT_DB_PASSWORD=change-me
APPLICANT_TASK_TIMEOUT_MS=2000
APPLICANT_MAX_CONCURRENT_TASKS=16

RECORD_IMAGE=andreiisthebest/student-id-university-record-service:lab3-0.3.0
RECORD_TASK_TIMEOUT_MS=2000
RECORD_MAX_CONCURRENT_TASKS=16
# Use a URL-safe password here: the record service receives it in a PostgreSQL URL.
RECORD_DB_PASSWORD=change-me

# Task limits. Over capacity answers 429 TASK_LIMIT_REACHED; past the deadline, 503
# TASK_TIMEOUT. Both default sensibly, so these only need setting to tune them.
MODERATION_MAX_CONCURRENT_DECISIONS=16
MODERATION_TASK_TIMEOUT_MS=5000
DMS_MAX_CONCURRENT_TASKS=16
DMS_TASK_TIMEOUT_SECONDS=5

# Fill after the Discovery-routing Gateway candidate publishes from reviewed main.
GATEWAY_IMAGE=vasiok11/student-id-gateway-service:lab3-0.4.0-build.31
# Base64 of the matching JWT issuer's PEM RSA PUBLIC key (at least 2048 bits).
# Never put a private signing key here. Empty keeps protected routes closed.
GATEWAY_JWT_PUBLIC_KEY_B64=
# Browser-reachable DMs WebSocket origin; use wss:// and a public host outside local development.
DMS_PUBLIC_WS_ORIGIN=ws://localhost:8088
DMS_SECOND_PUBLIC_WS_ORIGIN=ws://localhost:8091

# Fill after the controlled-removal Discovery candidate publishes from reviewed main.
DISCOVERY_IMAGE=cmmarin/student-id-service-discovery:lab3-0.5.0
# One generated 32-256 character URL-safe machine secret shared by Discovery,
# backend registrants and Gateway. This is not a Player JWT. Never commit its value.
DISCOVERY_REGISTRATION_TOKEN=
# Optional DMs ticket secret must match on both replicas when enabled.
WS_TICKET_SECRET=
# Wildcard is for local lab testing only; configure actual browser origins otherwise.
WS_ALLOWED_ORIGINS=*
