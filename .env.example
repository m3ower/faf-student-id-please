# Copy this file to .env and replace every password before starting the stack.
# Never commit .env.

# Docker Hub account that owns the Moderation and Discord DMs images. Note it is not
# the GitHub account name: the images live under meow3r.
DOCKERHUB_USER=meow3r
# Published release tested with the Lab 5 Warehouse scenario.
MODERATION_VERSION=lab3-0.13.2@sha256:82d648fe90549d31ef3260e2c84eab06eb4e0680b71c68b680bef08b119d3a52
MODERATION_DB_NAME=moderation
MODERATION_DB_USER=moderation
MODERATION_DB_PASSWORD=change-me
# Published Redis-backed DMs release tested with the Lab 5 Warehouse scenario.
DMS_VERSION=lab3-0.13.0@sha256:e34438ec4b97e14b0ddd2f8bb8ae083f028ca9bf24436e7b91dae7612e6413d7
DMS_REDIS_PASSWORD=change-me

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
CREDENTIAL_DB_NAME=credential_db
CREDENTIAL_DB_USER=credential_user
CREDENTIAL_DB_PASSWORD=change-me
RULES_DB_NAME=rules_db
RULES_DB_USER=rules_user
RULES_DB_PASSWORD=change-me
CREDENTIAL_IMAGE=cmmarin/student-id-credential-service:lab5-1.7.3@sha256:7db57ce43ef93a209f182a505c2cf48f00c9ead9d6111cdc54dbc2bc2314a5e4
RULES_IMAGE=cmmarin/student-id-rules-service:lab5-1.6.2@sha256:6ea60d1197f7cfc2cae5b9250c0e68de578d7f396cf031c93f3c83b2307e61b6

PLAYER_IMAGE=vasiok11/student-id-player-service:lab5-1.8.0-build.50@sha256:89bc6b93c6033e18c8d624b0ca37fa0ebae2434cebd797ea5bcb903ebc926efc
PLAYER_DB_NAME=player
PLAYER_DB_USER=player
PLAYER_DB_PASSWORD=change-me

# Published Session release with distributed SSE and measured status telemetry.
SESSION_IMAGE=vasiok11/student-id-session-service:lab5-1.8.0-build.56@sha256:20950f4fccfe58ff1d8fb4e71c1eea1e7e5bdb42fb4bc694c17dced562fe2fb4
SESSION_DB_NAME=session
SESSION_DB_USER=session
SESSION_DB_PASSWORD=change-me

APPLICANT_IMAGE=andreiisthebest/student-id-applicant-service:lab3-1.8.0@sha256:c8d3423cc22fad68aca114ad3544616a33fe88840717286b06ffa2d618700367
APPLICANT_DB_PASSWORD=change-me
APPLICANT_TASK_TIMEOUT_MS=2000
APPLICANT_MAX_CONCURRENT_TASKS=16

RECORD_IMAGE=andreiisthebest/student-id-university-record-service:lab3-1.8.0@sha256:e222cd4ee9c8e18a302c901003d0309527ff1bdff95b5c0672aac69efaee9ff4
RECORD_TASK_TIMEOUT_MS=2000
RECORD_MAX_CONCURRENT_TASKS=16
# Use a URL-safe password here: the record service receives it in a PostgreSQL URL.
RECORD_DB_PASSWORD=change-me

# Task limits. Over capacity answers 429 TASK_LIMIT_REACHED; past the deadline, 503
# TASK_TIMEOUT. Both default sensibly, so these only need setting to tune them.
MODERATION_MAX_CONCURRENT_DECISIONS=16
MODERATION_TASK_TIMEOUT_MS=5000
DMS_MAX_CONCURRENT_TASKS=16
DMS_TASK_TIMEOUT_SECONDS=5

# Round-robin over Discovery, circuit-trip logging and removal of tripped instances.
# Lab 4 MUST use the Broker overlay and its verified queue-capable
# OWNED_GATEWAY_IMAGE; this base-only selection is historical. See deployment/releases.json.
GATEWAY_IMAGE=vasiok11/student-id-gateway-service:lab4-2.1.1-build.59@sha256:1313c55b1295bb96c204025be0364dc6ed0dbb95555cd8e6b9ad78a916b1de5c
# Base64 of the matching JWT issuer's PEM RSA PUBLIC key (at least 2048 bits).
# Never put a private signing key here. Empty keeps protected routes closed.
GATEWAY_JWT_PUBLIC_KEY_B64=
# Browser-reachable DMs WebSocket origin; use wss:// and a public host outside local development.
DMS_PUBLIC_WS_ORIGIN=ws://localhost:8088
DMS_SECOND_PUBLIC_WS_ORIGIN=ws://localhost:8091

# Grade 10: removes an instance from the registry when its circuit trips.
DISCOVERY_IMAGE=cmmarin/student-id-service-discovery:lab4-0.8.0@sha256:e0e42009afe72b55331fbfa62cf117a1805c218f1f1fee7e9a4c530851d51d87
# Health poll interval. 5 s keeps the circuit window at task timeout x 3.5 = 17.5 s.
DISCOVERY_POLL_INTERVAL_SECONDS=5
# Optional https://discord.com/api/webhooks/<id>/<token> for health alerts. Never commit its value.
DISCOVERY_DISCORD_WEBHOOK_URL=
# Optional delivery tuning; blank uses Discovery's defaults (5 s per webhook call, 64 queued alerts).
DISCOVERY_NOTIFY_TIMEOUT_SECONDS=
DISCOVERY_NOTIFY_QUEUE_SIZE=
# One generated 32-256 character URL-safe machine secret shared by Discovery,
# backend registrants and Gateway. This is not a Player JWT. Never commit its value.
DISCOVERY_REGISTRATION_TOKEN=
# Optional DMs ticket secret must match on both replicas when enabled.
WS_TICKET_SECRET=
# Wildcard is for local lab testing only; configure actual browser origins otherwise.
WS_ALLOWED_ORIGINS=*
