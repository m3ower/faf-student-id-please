  "components": {
    "securitySchemes": {
      "ServiceBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ApplicantInitialized": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "type",
          "occurredAt",
          "producer",
          "version",
          "payload"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "const": "ApplicantInitialized"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "producer": {
            "enum": [
              "applicant-service",
              "credential-service",
              "university-record-service"
            ]
          },
          "version": {
            "const": 1
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "applicantId",
              "seed",
              "initiator",
              "identity",
              "deception"
            ],
            "properties": {
              "applicantId": {
                "type": "string",
                "format": "uuid"
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "initiator": {
                "enum": [
                  "applicant-service",
                  "credential-service",
                  "university-record-service"
                ]
              },
              "identity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "studentId",
                  "year"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "studentId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]{1,64}$"
                  },
                  "year": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  }
                }
              },
              "deception": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "impersonatedStudentId",
                  "inconsistentFields"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "NONE",
                      "IMPERSONATION",
                      "FORGED_DOCUMENT",
                      "EXPIRED_DOCUMENT",
                      "INCONSISTENT_CLAIM",
                      "NOT_ENROLLED",
                      "PREVIOUSLY_BANNED"
                    ]
                  },
                  "impersonatedStudentId": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "inconsistentFields": {
                    "type": "array",
                    "uniqueItems": true,
                    "maxItems": 3,
                    "items": {
                      "enum": [
                        "name",
                        "major",
                        "year"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Generation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "applicantId",
          "sessionId",
          "seed",
          "difficulty"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "applicantId": {
            "type": "string",
            "format": "uuid"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "difficulty": {
            "enum": [
              "EASY",
              "NORMAL",
              "HARD"
            ]
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "applicantId",
          "eventId",
          "eventHash",
          "status"
        ],
        "properties": {
          "applicantId": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
