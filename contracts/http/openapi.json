              "rulesetVersion"
            ],
            "properties": {
              "sessionId": {
                "$ref": "#/components/schemas/uuid"
              },
              "players": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "$ref": "#/components/schemas/uuid"
                }
              },
              "rulesetVersion": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "decisionRecordedEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/envelope"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DecisionRecorded"
            ]
          },
          "producer": {
            "type": "string",
            "enum": [
              "moderation-service"
            ]
          },
          "payload": {
            "type": "object",
            "required": [
              "decisionId",
              "sessionId",
              "applicantId",
              "moderatorId",
              "action",
              "correct",
              "scoreDelta"
            ],
            "properties": {
              "decisionId": {
                "$ref": "#/components/schemas/uuid"
              },
              "sessionId": {
                "$ref": "#/components/schemas/uuid"
              },
              "applicantId": {
                "$ref": "#/components/schemas/uuid"
              },
              "moderatorId": {
                "$ref": "#/components/schemas/uuid"
              },
              "action": {
                "type": "string",
                "enum": [
                  "ACCEPT",
                  "REJECT",
                  "FLAG",
                  "BAN"
                ]
              },
              "correct": {
                "type": "boolean"
              },
              "scoreDelta": {
                "type": "integer"
              }
            }
          }
        }
      },
      "eventAck": {
        "type": "object",
        "required": [
          "eventId",
          "status"
        ],
        "properties": {
          "eventId": {
            "$ref": "#/components/schemas/uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PROCESSED",
              "DUPLICATE"
            ]
          }
        }
      },
      "errorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "service",
              "traceId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "service": {
                "type": "string"
              },
              "traceId": {
                "type": "string"
              }
            }
          }
        }
      }
