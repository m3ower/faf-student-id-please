        "required": [
          "sessionId",
          "playerId"
        ],
        "properties": {
          "sessionId": {
            "$ref": "#/components/schemas/uuid"
          },
          "playerId": {
            "$ref": "#/components/schemas/uuid"
          }
        }
      },
      "membershipResponse": {
        "type": "object",
        "required": [
          "member",
          "role",
          "recordAccess",
          "channels"
        ],
        "properties": {
          "member": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "enum": [
              "",
              "MODERATOR",
              "JUNIOR_MODERATOR"
            ]
          },
          "recordAccess": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ENROLLMENT_LIST",
                "OUTLOOK_GROUPS",
                "COURSE_CATALOG",
                "FCIM_RECORD"
              ]
            }
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "#enrollment-check",
                "#faculty-check",
                "#course-registration",
                "#general-mod-chat"
              ]
            }
          },
          "playerName": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "scoreChangeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scoreChangeId",
          "sessionId",
          "decisionId",
          "applicantId",
          "moderatorId",
          "reason",
          "delta",
          "penalties"
        ],
        "properties": {
          "scoreChangeId": {
            "$ref": "#/components/schemas/uuid"
          },
          "sessionId": {
            "$ref": "#/components/schemas/uuid"
          },
          "decisionId": {
            "$ref": "#/components/schemas/uuid"
          },
          "applicantId": {
            "$ref": "#/components/schemas/uuid"
          },
          "moderatorId": {
            "$ref": "#/components/schemas/uuid"
          },
          "reason": {
            "type": "string",
            "enum": [
              "DECISION",
              "APPEAL_REFUND",
              "DECISION_VOID"
            ]
          },
          "delta": {
            "type": "integer",
            "minimum": -10000,
            "maximum": 10000
          },
          "penalties": {
            "type": "integer",
            "minimum": -1,
            "maximum": 1
          }
        }
      },
      "scoreChangeResponse": {
        "type": "object",
        "required": [
          "scoreChangeId",
          "applied",
          "score",
          "penalties"
        ],
        "properties": {
          "scoreChangeId": {
            "$ref": "#/components/schemas/uuid"
          },
          "applied": {
            "type": "boolean"
          },
          "score": {
            "type": "integer"
          },
          "penalties": {
            "type": "integer"
          }
        }
      },
      "deceptionResponse": {
        "type": "object",
        "required": [
          "applicantId",
          "type"
        ],
        "properties": {
          "applicantId": {
            "$ref": "#/components/schemas/uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "NONE",
              "IMPERSONATION",
              "FORGED_DOCUMENT",
              "EXPIRED_DOCUMENT",
              "INCONSISTENT_CLAIM",
              "NOT_ENROLLED",
              "PREVIOUSLY_BANNED"
            ]
          },
          "impersonatedStudentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "inconsistentFields": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "credentialListResponse": {
        "type": "object",
        "required": [
          "applicantId",
          "credentials"
        ],
        "properties": {
          "applicantId": {
            "$ref": "#/components/schemas/uuid"
          },
          "credentials": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "credentialId",
                "applicantId",
                "type"
              ],
              "properties": {
                "credentialId": {
                  "$ref": "#/components/schemas/uuid"
                },
                "applicantId": {
                  "$ref": "#/components/schemas/uuid"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "STUDENT_ID",
                    "UNIVERSITY_EMAIL",
                    "ENROLLMENT_CONFIRMATION",
                    "COURSE_REGISTRATION"
                  ]
                }
              }
            }
          }
        }
      },
      "credentialValidationResponse": {
        "type": "object",
        "required": [
          "credentialId",
          "type",
          "structurallyValid",
          "authentic",
          "issues"
        ],
        "properties": {
          "credentialId": {
            "$ref": "#/components/schemas/uuid"
          },
          "type": {
            "type": "string",
