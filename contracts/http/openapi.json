              "UNIVERSITY_EMAIL",
              "ENROLLMENT_CONFIRMATION",
              "COURSE_REGISTRATION"
            ]
          },
          "structurallyValid": {
            "type": "boolean"
          },
          "authentic": {
            "type": "boolean"
          },
          "issues": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "rulesEvaluationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "applicantId"
        ],
        "properties": {
          "sessionId": {
            "$ref": "#/components/schemas/uuid"
          },
          "applicantId": {
            "$ref": "#/components/schemas/uuid"
          }
        }
      },
      "rulesEvaluationResponse": {
        "type": "object",
        "required": [
          "applicantId",
          "rulesetVersion",
          "violations",
          "recommendedAction"
        ],
        "properties": {
          "applicantId": {
            "$ref": "#/components/schemas/uuid"
          },
          "rulesetVersion": {
            "type": "integer",
            "minimum": 1
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "severity"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "MINOR",
                    "MAJOR",
                    "CRITICAL"
                  ]
                }
              }
            }
          },
          "recommendedAction": {
            "type": "string",
            "enum": [
              "ACCEPT",
              "REJECT",
              "FLAG",
              "BAN"
            ]
          }
        }
      },
      "decisionFactsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "applicantId",
          "previouslyBanned",
          "decisions"
        ],
        "properties": {
          "applicantId": {
            "$ref": "#/components/schemas/uuid"
          },
          "previouslyBanned": {
            "type": "boolean"
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decisionId",
                "sessionId",
                "action",
                "decidedAt"
              ],
              "properties": {
                "decisionId": {
                  "$ref": "#/components/schemas/uuid"
                },
                "sessionId": {
                  "$ref": "#/components/schemas/uuid"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "ACCEPT",
                    "REJECT",
                    "FLAG",
                    "BAN"
                  ]
                },
                "decidedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "envelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "type",
          "occurredAt",
          "producer",
          "version",
          "payload"
        ],
        "properties": {
          "eventId": {
            "$ref": "#/components/schemas/uuid"
          },
          "type": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "producer": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "payload": {
            "type": "object"
          }
        }
      },
