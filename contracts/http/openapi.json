        "allOf": [
          {
            "$ref": "#/components/schemas/envelope"
          }
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "ShiftStarted"
            ]
          },
          "producer": {
            "type": "string",
            "enum": [
              "session-service"
            ]
          },
          "payload": {
            "type": "object",
            "required": [
              "sessionId",
