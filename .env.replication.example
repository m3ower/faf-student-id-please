# Lab 5 replication and failover (docker-compose.replication.yml). Add to the same ignored
# private .env as the base and owned-broker files; never commit real values.
# Passwords: distinct, 32+ URL-safe characters, not reused from any other credential.

# The PostgreSQL replication role's password, separate from MODERATION_DB_PASSWORD.
MODERATION_DB_REPLICATION_PASSWORD=
# Protects the three Redis Sentinels; separate from DMS_REDIS_PASSWORD.
DMS_REDIS_SENTINEL_PASSWORD=

# Service versions that understand failover: Moderation answers retryable 503s while the
# database fails over; DMs follows the Sentinels to the current master.
REPLICATION_MODERATION_VERSION=lab3-0.11.0
REPLICATION_DMS_VERSION=lab3-0.11.0
