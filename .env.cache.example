# Lab 5 caching (docker-compose.cache.yml). Add to the same ignored private .env as the base
# and owned-broker files; never commit real values.

# Moderation's cache password: 16+ characters, not reused from any other credential.
MODERATION_CACHE_PASSWORD=

# Service versions with caching. Lab 5 releases are cumulative, so with
# docker-compose.replication.yml use the same versions for REPLICATION_*_VERSION as well.
CACHE_MODERATION_VERSION=lab3-0.12.0
CACHE_DMS_VERSION=lab3-0.12.0

# Optional tuning (these are the defaults).
# MODERATION_CACHE_TTL=60s
# MODERATION_MEMBERSHIP_CACHE_TTL=30s
# MODERATION_MEMBERSHIP_NEGATIVE_TTL=5s
# DMS_MEMBERSHIP_CACHE_SECONDS=30
# DMS_MEMBERSHIP_NEGATIVE_CACHE_SECONDS=5
