            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const suffix = pm.variables.replaceIn(\"{{$guid}}\");",
                  "pm.variables.set(\"suffix\", suffix);",
                  "pm.variables.set(\"password\", \"Test-\" + suffix);",
                  "pm.variables.set(\"email\", \"session-host-\" + suffix + \"@example.test\");",
                  "pm.variables.set(\"juniorEmail\", \"session-junior-\" + suffix + \"@example.test\");"
