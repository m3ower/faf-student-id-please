{
  "info": {
    "name": "Student ID - Discord DMs Service",
    "description": "Discord DMs Service (Go). Run the whole collection with the Runner; the first request starts a fresh session id.\n\nWebSocket (use Postman's New > WebSocket, collections cannot store WS requests):\nws://localhost:8088/ws/v1/sessions/{{sessionId}}?playerId=22222222-2222-2222-2222-222222222222&token=dev\nSend: {\"type\":\"MESSAGE_SEND\",\"channel\":\"#enrollment-check\",\"content\":\"hello\"}\nOpen a second tab as the moderator (1111...) to watch it arrive, and one as 3333... to see that it does not.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088"
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "moderatorId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "junior1Id",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "junior2Id",
      "value": "33333333-3333-3333-3333-333333333333"
    },
    {
      "key": "junior3Id",
      "value": "44444444-4444-4444-4444-444444444444"
    },
    {
      "key": "messageId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Health (starts a fresh session)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"sessionId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create default channels (internal)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/internal/sessions/{{sessionId}}/channels/defaults",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "internal",
                "sessions",
                "{{sessionId}}",
                "channels",
                "defaults"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"4 channels\", () => pm.expect(pm.response.json().channels.length).to.eql(4));"
                ]
              }
            }
          ]
        }
      ]
    },
