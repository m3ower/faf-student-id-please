{
  "info": {
    "name": "Student ID - Discord DMs Service",
    "description": "Discord DMs lab3-0.8.0 public REST through Gateway at http://localhost:8090. Permissions come from real Session membership via Broker gRPC. Set actual sessionId and player JWTs with the channel assignments used by these requests; ShiftStarted must have reached the DMs consumer through Broker. No fixture membership or internal stand-in endpoints. Negotiate WebSocket access through Gateway, then connect directly to the returned DMs instance URL. Keep all player tokens private; clients do not choose X-Player-Id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{moderatorToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "moderatorToken",
      "value": ""
    },
    {
      "key": "junior1Token",
      "value": ""
    },
    {
      "key": "junior2Token",
      "value": ""
    },
    {
      "key": "outsiderToken",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health/discord-dms-service",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health",
                "discord-dms-service"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"sessionId is set to a real session\", () => pm.expect(pm.collectionVariables.get(\"sessionId\") || pm.environment.get(\"sessionId\")).to.be.ok);"
                ]
              }
            }
          ]
        }
      ]
    },
