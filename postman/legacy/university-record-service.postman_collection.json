          "request": {
            "method": "POST",
            "url": "{{brokerBaseUrl}}/internal/v1/records/events/credentials-ready",
            "description": "Use an actual Credential callback from the private local test run, matching integrationApplicantId and parent request/event ID. Identical replay 200; changed content or causation 409. A callback alone cannot establish READY.",
            "auth": {
