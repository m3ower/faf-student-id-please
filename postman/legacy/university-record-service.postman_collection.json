  "item": [
    {
      "name": "Owned Message Broker integration candidate",
      "description": "Run against the reviewed Gateway registry and candidate service images. No X-Service-Name is supplied by this client: Gateway derives it from each distinct caller credential. Generation persists pending state; 202 is not a ready applicant. Supply initializationEnvelope only for receiver contract testing. Tokens remain empty in this export.",
      "item": [
        {
          "name": "record.enrollmentFacts",
          "request": {
            "method": "GET",
            "url": "{{brokerBaseUrl}}/internal/v1/records/{{integrationApplicantId}}/facts",
            "description": "Authoritative persisted Record truth, accessible only to Credential and Rules using service identity. NOT_ENROLLED is enrolled=false and record=null; claimed identity is never rewritten to match truth.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "type": "string",
                  "value": "{{credentialServiceToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "owned-postman-{{integrationRequestId}}",
                "type": "text"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Documented response', function() { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test('Trace correlation returned', function(){pm.expect(pm.response.headers.get('X-Trace-Id')).to.eql(pm.variables.replaceIn('owned-postman-{{integrationRequestId}}'));});",
                  "pm.test('Negative truth is explicit',function(){var body=pm.response.json();pm.expect(body.enrolled).to.be.a('boolean');if(!body.enrolled)pm.expect(body.record).to.eql(null);});"
                ]
              }
            }
          ]
        },
        {
          "name": "record.generate",
          "request": {
            "method": "POST",
            "url": "{{brokerBaseUrl}}/internal/v1/records/generate",
            "description": "Owned persisted HTTP baseline. Initialization consumers commit only their component and receipt, without republishing. Readiness checks both peer local receipts in parallel; missing, denied, malformed or unavailable peers keep the item pending.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "type": "string",
                  "value": "{{sessionServiceToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "owned-postman-{{integrationRequestId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"requestId\":\"{{integrationRequestId}}\",\"applicantId\":\"{{integrationApplicantId}}\",\"sessionId\":\"{{integrationSessionId}}\",\"seed\":{{integrationSeed}},\"difficulty\":\"{{integrationDifficulty}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "['integrationApplicantId','integrationRequestId','unknownIntegrationId'].forEach(function(key){ if (!pm.collectionVariables.get(key)) pm.collectionVariables.set(key, pm.variables.replaceIn('{{$guid}}')); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Documented response', function() { pm.expect(pm.response.code).to.be.oneOf([202]); });",
                  "pm.test('Trace correlation returned', function(){pm.expect(pm.response.headers.get('X-Trace-Id')).to.eql(pm.variables.replaceIn('owned-postman-{{integrationRequestId}}'));});",
                  "pm.test('Readiness is explicit',function(){ var body=pm.response.json(); pm.expect(body.ready).to.be.a('boolean'); if(pm.response.code===202) pm.expect(body.ready).to.eql(false); else pm.expect(body.ready).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
