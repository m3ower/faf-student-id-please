{
  "info": {
    "name": "Student ID - Applicant Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8090"},
    {"key": "applicantId", "value": ""}
  ],
  "item": [
    {
      "name": "Create",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/v1/applicants",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana Popescu\",\n  \"studentId\": \"FAF-221\",\n  \"major\": \"FAF\",\n  \"studyYear\": 2,\n  \"universityStatus\": \"ENROLLED\",\n  \"role\": \"STUDENT\",\n  \"courses\": [\"PAD\", \"OOP\"]\n}"
        }
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Created', function () { pm.response.to.have.status(201); });",
        "if (pm.response.code === 201) pm.collectionVariables.set('applicantId', pm.response.json().id);"
      ]}}]
    },
    {
      "name": "List",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/applicants"},
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Listed', function () { pm.response.to.have.status(200); });"
      ]}}]
    },
    {
      "name": "Get by ID",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/applicants/{{applicantId}}"},
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Found', function () { pm.response.to.have.status(200); });"
      ]}}]
    },
    {
      "name": "Update",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/v1/applicants/{{applicantId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Ana Popescu\",\"studentId\":\"FAF-221\",\"major\":\"FAF\",\"studyYear\":3,\"universityStatus\":\"ENROLLED\",\"role\":\"STUDENT\",\"courses\":[\"PAD\"]}"
        }
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Updated', function () { pm.response.to.have.status(200); });"
      ]}}]
    },
    {
      "name": "Invalid input",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/v1/applicants",
        "body": {"mode": "raw", "raw": "{\"name\":\"\",\"studentId\":\"\"}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Invalid input rejected', function () { pm.response.to.have.status(400); });"
      ]}}]
    },
    {
      "name": "Delete",
      "request": {"method": "DELETE", "url": "{{baseUrl}}/api/v1/applicants/{{applicantId}}"},
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Deleted', function () { pm.response.to.have.status(204); });"
      ]}}]
    },
    {
      "name": "Get deleted applicant",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/applicants/{{applicantId}}"},
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Missing applicant returns 404', function () { pm.response.to.have.status(404); });"
      ]}}]
    }
  ]
}
