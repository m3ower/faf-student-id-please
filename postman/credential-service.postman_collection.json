{
  "info": {
    "name": "Student ID - Credential Service",
    "description": "Authentication: protected Gateway requests inherit Bearer {{accessToken}}. Select a private local Postman environment containing an explicitly disposable, one-hour local test access JWT, using the same Gateway public-key setup as the Player/Session collections. Player has no login, refresh or JWT issuance. Regenerate expired tokens locally; keep tokens and private keys out of tracked files. Gateway removes Authorization before forwarding and does not bind JWT sub to client-provided X-Player-Id; existing service header checks remain unchanged.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "accessToken", "value": "", "type": "string", "description": "Disposable local test JWT. Set in a private local environment; keep this collection value empty." },
    { "key": "baseUrl", "value": "http://localhost:8090" },
    { "key": "applicantId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "credentialId", "value": "" },
    { "key": "sessionId", "value": "lab1-session" }
  ],
  "item": [
    {
      "name": "Create credential",
      "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('credentialId', pm.response.json().credentialId);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"applicantId\": \"{{applicantId}}\",\n  \"type\": \"STUDENT_ID\",\n  \"issuedAt\": \"2024-09-01\",\n  \"expiresAt\": \"2028-07-01\",\n  \"fields\": { \"studentId\": \"FAF-221\", \"photoUrl\": \"https://example.test/photo.jpg\" }\n}" },
        "url": "{{baseUrl}}/api/v1/credentials"
      }
    },
    { "name": "Get credential", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/credentials/{{credentialId}}" } },
    {
      "name": "Update credential",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"applicantId\": \"{{applicantId}}\",\n  \"type\": \"UNIVERSITY_EMAIL\",\n  \"fields\": { \"email\": \"student@isa.utm.md\" }\n}" },
        "url": "{{baseUrl}}/api/v1/credentials/{{credentialId}}"
      }
    },
    {
      "name": "List applicant credentials",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Session-Id", "value": "{{sessionId}}" }],
        "url": "{{baseUrl}}/api/v1/credentials/applicant/{{applicantId}}"
      }
    },
    { "name": "List credential types", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/credentials/types" } },
    { "name": "Delete credential", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/credentials/{{credentialId}}" } }
  ]
}
