{
  "info": {
    "name": "Student ID - Moderation Service",
    "description": "Moderation Service (Java). Run the whole collection with the Runner: the first request starts a fresh session id, so the collection can be re-run any number of times. Downstream services are mocked; see the service README for the demo applicant ids.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8087"
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "moderatorId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "decisionId",
      "value": ""
    },
    {
      "key": "flagDecisionId",
      "value": ""
    },
    {
      "key": "policyId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health (starts a fresh session)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/q/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "q",
                "health",
                "ready"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"sessionId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.test(\"UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Decisions",
      "item": [
        {
          "name": "Submit - correct BAN on previously banned applicant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/decisions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "decisions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"applicantId\": \"a0000000-0000-0000-0000-000000000003\",\n  \"moderatorId\": \"{{moderatorId}}\",\n  \"action\": \"BAN\",\n  \"reason\": \"Postman run\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"decisionId\", b.decisionId);",
                  "pm.test(\"correct\", () => pm.expect(b.correct).to.be.true);",
                  "pm.test(\"+100\", () => pm.expect(b.scoreDelta).to.eql(100));"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit - wrong ACCEPT on rule breaker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
