            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"applicantId\": \"a0000000-0000-0000-0000-000000000008\",\n  \"moderatorId\": \"{{moderatorId}}\",\n  \"action\": \"ACCEPT\",\n  \"reason\": \"Postman run\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"incorrect\", () => pm.expect(b.correct).to.be.false);",
                  "pm.test(\"expected REJECT\", () => pm.expect(b.expectedAction).to.eql(\"REJECT\"));",
                  "pm.test(\"MIN_2_YEARS violated\", () => pm.expect(b.violatedRules).to.include(\"MIN_2_YEARS\"));",
                  "pm.test(\"penalty 100\", () => pm.expect(b.penalty).to.eql(100));"
                ]
              }
            }
