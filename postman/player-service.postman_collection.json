{
  "info": {
    "name": "Student ID - Player Service",
    "description": "Real Player CRUD/login/teams through Gateway at localhost:8090. Run in order against the new baseline source/reviewed image, not the old pinned Lab 3 image. Player and Gateway require matching RSA private/public keys and distinct machine target credentials. Login supplies real access/refresh tokens in transient runner variables; never export populated secrets. Backend identity is bound to verified JWT sub. Synthetic accounts are deleted at the end; no internal operations or fabricated JWTs are used. Refreshed 2026-11-12 from shared dev bdf7190. Gateway boundary and separate operational log checks are included. Current private service source was not accessible during this review; public shared contracts do not establish runtime acceptance. See ../docs/lab4-configuration-review.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "Real login-issued access token. Kept empty in Git; runner stores it transiently."
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "updatedUsername",
      "value": ""
    },
    {
      "key": "updatedEmail",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "teamId",
      "value": ""
    },
    {
      "key": "logDownloadUrl",
      "value": "http://127.0.0.1:8092",
      "description": "Local operational log endpoint; independent of Gateway baseUrl."
    },
    {
      "key": "logDownloadToken",
      "value": "",
      "type": "string",
      "description": "Separate operations secret. Set only in a private local environment; never commit it."
    }
  ],
  "item": [
    {
      "name": "Lab 4 Task 3 - Gateway boundary",
      "description": "Public Gateway health, JWT and internal-route boundary checks. Run with the current Lab 4 subscriber-queue Gateway/Broker deployment.",
      "item": [
        {
          "name": "Owned service health through Gateway",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/v1/health/player-service",
            "description": "Public Gateway relay for this service's existing health/readiness endpoint. Requires a running, healthy service and its database; this does not probe the custom broker.",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Service health through Gateway: HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing bearer token is rejected",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/v1/players",
            "description": "Explicit No Auth overrides the collection bearer token. Gateway must reject this request before forwarding it to the owned service.",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Gateway rejects unauthorized access: HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('Gateway uses the existing authentication error contract', () => { const error = pm.response.json().error; pm.expect(error.code).to.eql('UNAUTHENTICATED'); pm.expect(error.service).to.eql('gateway-service'); pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Bearer'); });",
                  "pm.test('Authentication error matches the response trace ID', () => { const traceId = pm.response.headers.get('X-Trace-Id'); pm.expect(traceId).to.be.a('string').and.not.empty; pm.expect(pm.response.json().error.traceId).to.eql(traceId); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed bearer header is rejected",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer"
              }
            ],
            "url": "{{baseUrl}}/api/v1/players",
            "description": "No Auth disables inherited authorization; the deliberately incomplete Bearer header contains no token. Gateway must return its existing 401 error."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Gateway rejects unauthorized access: HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('Gateway uses the existing authentication error contract', () => { const error = pm.response.json().error; pm.expect(error.code).to.eql('UNAUTHENTICATED'); pm.expect(error.service).to.eql('gateway-service'); pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Bearer'); });",
                  "pm.test('Authentication error matches the response trace ID', () => { const traceId = pm.response.headers.get('X-Trace-Id'); pm.expect(traceId).to.be.a('string').and.not.empty; pm.expect(pm.response.json().error.traceId).to.eql(traceId); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway hides internal service routes",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/internal/v1/applicants/00000000-0000-0000-0000-000000000001/readiness"
          },
          "event": [
            {
              "listen": "test",
