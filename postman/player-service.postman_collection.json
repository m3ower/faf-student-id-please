{
  "info": {
    "name": "Student ID - Player Service",
    "description": "Player Service CRUD through the shared Python Gateway at http://localhost:8090. Run the collection in order; it creates a fresh player and stores its ID as a collection variable. Health and registration are public. Protected requests inherit Bearer {{accessToken}}; set accessToken in a private local Postman environment. Use explicitly disposable local test JWTs: Player does not implement login, refresh or token issuance. Gateway requires RS256 with an RSA key of at least 2048 bits, iss=student-id-player-service, aud=student-id-api, sub=a player UUID, token_use=access, and numeric iat/exp at most 3600 seconds apart. Regenerate expired tokens locally; never export populated tokens or private signing keys into tracked files. Gateway removes Authorization before forwarding and does not bind JWT sub to client-provided X-Player-Id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8090" },
    { "key": "accessToken", "value": "", "type": "string", "description": "Disposable local test JWT. Set in a private local environment; keep this collection value empty." },
    { "key": "playerId", "value": "" },
    { "key": "username", "value": "" },
    { "key": "email", "value": "" },
    { "key": "updatedUsername", "value": "" },
    { "key": "updatedEmail", "value": "" }
  ],
  "item": [
    {
      "name": "Health and setup",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/health/player-service", "host": ["{{baseUrl}}"], "path": ["api", "v1", "health", "player-service"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
          "pm.test(\"service is UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));",
          "const suffix = pm.variables.replaceIn(\"{{$guid}}\");",
          "pm.collectionVariables.set(\"username\", \"player-\" + suffix);",
          "pm.collectionVariables.set(\"email\", \"player-\" + suffix + \"@example.com\");",
          "pm.collectionVariables.set(\"updatedUsername\", \"updated-\" + suffix);",
          "pm.collectionVariables.set(\"updatedEmail\", \"updated-\" + suffix + \"@example.com\");"
        ] }
      }]
    },
    {
      "name": "Register player",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/players/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "players", "register"] }
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
          "const body = pm.response.json();",
          "pm.collectionVariables.set(\"playerId\", body.playerId);",
          "pm.test(\"starts at level one\", () => pm.expect(body.level).to.eql(1));",
          "pm.test(\"starts with zero XP\", () => pm.expect(body.xp).to.eql(0));"
        ] }
      }]
    },
    {
      "name": "Get registered player",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/players/{{playerId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "players", "{{playerId}}"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
        "pm.test(\"username matches\", () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get(\"username\")));"
      ] } }]
    },
    {
      "name": "Update player profile",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{updatedUsername}}\",\n  \"email\": \"{{updatedEmail}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/players/{{playerId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "players", "{{playerId}}"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
        "pm.test(\"username updated\", () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get(\"updatedUsername\")));"
      ] } }]
    },
    {
      "name": "Get updated player",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/players/{{playerId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "players", "{{playerId}}"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
        "pm.test(\"updated username persists\", () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get(\"updatedUsername\")));"
      ] } }]
    },
    {
      "name": "Register duplicate player (409)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{updatedUsername}}\",\n  \"email\": \"{{updatedEmail}}\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/v1/players/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "players", "register"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"status is 409\", () => pm.response.to.have.status(409));",
        "pm.test(\"duplicate error code\", () => pm.expect(pm.response.json().error.code).to.eql(\"PLAYER_ALREADY_EXISTS\"));"
      ] } }]
    },
    {
      "name": "Delete player",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/players/{{playerId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "players", "{{playerId}}"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
      ] } }]
    },
    {
      "name": "Get deleted player (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/players/{{playerId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "players", "{{playerId}}"] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
        "pm.test(\"player not found\", () => pm.expect(pm.response.json().error.code).to.eql(\"PLAYER_NOT_FOUND\"));"
      ] } }]
    }
  ]
}
