# Add these to a PRIVATE deployment environment when selecting the opt-in overlay.
# All image values must identify the migrated source, never old latest tags.
# The selected service/Gateway/Discovery tags and digests were verified against
# public Registry manifests and source-revision labels on 2026-11-12. This proves
# publication, not runtime acceptance. Broker remains blocked; see the review.
OWNED_APPLICANT_IMAGE=andreiisthebest/student-id-applicant-service:lab3-1.2.0-92e7b9f0f3d3@sha256:c8c9fc71efcaa28f08a0a8f10ced2335fe123b9039f49abfbadffc3447f3e9bf
OWNED_RECORD_IMAGE=andreiisthebest/student-id-university-record-service:lab3-1.2.0-76e831c19d39@sha256:ef316f3ed3058fc2ad5a33ed82112e91d9a03dace78bccc6c7bae590734bf0f6
# Moderation/DMs lab3-0.8.0 publish over gRPC: the Broker image must serve gRPC
# (andreiisthebest/student-id-message-broker:lab4-0.6.0 or later, once released).
# Select a published Broker whose bundled transports match contracts/proto/transports.json.
# The inspected 0.6.3 dev source still delivers Credential/Rules over HTTP and does
# not match the shared all-gRPC catalog. Do not assume that tag satisfies Task 8.
OWNED_BROKER_IMAGE=
OWNED_DISCOVERY_IMAGE=cmmarin/student-id-service-discovery:lab4-0.8.0@sha256:e0e42009afe72b55331fbfa62cf117a1805c218f1f1fee7e9a4c530851d51d87
# Credential/Rules gRPC-capable releases. Verify publication/source labels before use.
OWNED_CREDENTIAL_IMAGE=cmmarin/student-id-credential-service:lab4-1.1.0@sha256:cc0ef68a3632768ef69c7c2d0d7a4cd36957709f46dec06c08d5cc970fb141fc
OWNED_RULES_IMAGE=cmmarin/student-id-rules-service:lab4-1.1.0@sha256:e5efb983211ffdf74b75372af6a753368d07888108dc0a7397303ea7acfe53a1
# The opt-in overlay requires gRPC for these two owned services; rolling back
# requires a coordinated deployment/catalog change, never silent HTTP fallback.
CREDENTIAL_BROKER_SERVICE_TOKEN=
RULES_BROKER_SERVICE_TOKEN=
# Moderation and Discord DMs: the reviewed lab3-0.8.0 releases (gRPC to the Broker) are
# the defaults; override only with another published, reviewed tag.
# Published 12 Nov 2026: moderation sha256:2d539f5ce3f2f067c05ebff3c325bd11209e28eebf8cff51ff2fd30ec288246c,
# dms sha256:dcd893cc6615783927c8aea0c4bdab7c309d59d15d4e1765338cc6e901c98d3f.
OWNED_MODERATION_VERSION=lab3-0.8.0@sha256:2d539f5ce3f2f067c05ebff3c325bd11209e28eebf8cff51ff2fd30ec288246c
OWNED_DMS_VERSION=lab3-0.8.0@sha256:dcd893cc6615783927c8aea0c4bdab7c309d59d15d4e1765338cc6e901c98d3f

# Each caller token is distinct from every target/management/Discovery credential.
# The JSON map must contain applicant-service and university-record-service with
# exactly the respective caller values below, plus any actual peer callers.
BROKER_CALLER_TOKENS_JSON=
APPLICANT_BROKER_SERVICE_TOKEN=
RECORD_BROKER_SERVICE_TOKEN=
# Moderation's and DMs' own caller credentials; BROKER_CALLER_TOKENS_JSON must map
# moderation-service and discord-dms-service to exactly these values.
MODERATION_BROKER_SERVICE_TOKEN=
DMS_BROKER_SERVICE_TOKEN=
APPLICANT_INTERNAL_TOKEN=
RECORD_INTERNAL_TOKEN=
CREDENTIAL_INTERNAL_TOKEN=
SESSION_INTERNAL_TOKEN=
APPLICANT_MANAGEMENT_TOKEN=
RECORD_MANAGEMENT_TOKEN=

# Public JWTs stop at Gateway. The Broker owns all target credentials; the new
# subscriber-queue Gateway does not use GATEWAY_TARGET_TOKENS_JSON.

# Receiver credentials. Moderation and DMs are required with this overlay; the Broker
# presents them on gRPC deliveries and the services check them. Discord DMs also needs
# GATEWAY_JWT_PUBLIC_KEY_B64 from .env (the Player public key).
MODERATION_INTERNAL_TOKEN=
DMS_INTERNAL_TOKEN=
# Required Rules and Player receivers in the full Lab 4 overlay.
RULES_INTERNAL_TOKEN=
PLAYER_INTERNAL_TOKEN=

# Gateway subscriber queues, Player signing and Player/Session gRPC messaging.
# Published tags and immutable digests checked on 2026-11-12; real-peer acceptance remains required.
OWNED_GATEWAY_IMAGE=vasiok11/student-id-gateway-service:lab4-2.1.1-build.59@sha256:1313c55b1295bb96c204025be0364dc6ed0dbb95555cd8e6b9ad78a916b1de5c
OWNED_PLAYER_IMAGE=vasiok11/student-id-player-service:lab4-1.3.0-build.31@sha256:763900c6aa4e558577109533085ee5f17e18039c67729e69ed9312613a134ab0
OWNED_SESSION_IMAGE=vasiok11/student-id-session-service:lab4-1.3.0-build.37@sha256:0f665df586476dbefcb682c6e72b612db8567f1e9af02bcda8662b3073808dc2
GATEWAY_BROKER_SERVICE_TOKEN=
PLAYER_BROKER_SERVICE_TOKEN=
SESSION_BROKER_SERVICE_TOKEN=
# Locally generated PKCS#8 RSA private key, base64 encoded. Never export/commit it.
# GATEWAY_JWT_PUBLIC_KEY_B64 must contain its matching public key.
PLAYER_JWT_PRIVATE_KEY_B64=
# Include gateway-service and all eight service callers in BROKER_CALLER_TOKENS_JSON,
# each mapped to its distinct *_BROKER_SERVICE_TOKEN above.
