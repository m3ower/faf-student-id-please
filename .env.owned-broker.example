# Add these to a PRIVATE deployment environment when selecting the opt-in overlay.
# All image values must identify the migrated source, never old latest tags.
# Published tags, digests and source revisions checked on 2026-11-26.
# This combination passed populated Warehouse acceptance; see docs/lab5-release-pins.md.
OWNED_APPLICANT_IMAGE=andreiisthebest/student-id-applicant-service:lab3-1.8.0@sha256:c8d3423cc22fad68aca114ad3544616a33fe88840717286b06ffa2d618700367
OWNED_RECORD_IMAGE=andreiisthebest/student-id-university-record-service:lab3-1.8.0@sha256:e222cd4ee9c8e18a302c901003d0309527ff1bdff95b5c0672aac69efaee9ff4
# Broker serves the shared gRPC transport and durable queues.
OWNED_BROKER_IMAGE=andreiisthebest/student-id-message-broker:lab4-0.9.0@sha256:4eae9c3d4d0bfb5c730b27416daee095d4a74ae68bdfd3710d2588cbb711e163
# The overlay mounts broker-data at /data; never remove that volume during restart.
BROKER_DEAD_LETTER_CAPACITY=8192
OWNED_DISCOVERY_IMAGE=cmmarin/student-id-service-discovery:lab4-0.8.0@sha256:e0e42009afe72b55331fbfa62cf117a1805c218f1f1fee7e9a4c530851d51d87
# Credential/Rules gRPC-capable releases. Verify publication/source labels before use.
OWNED_CREDENTIAL_IMAGE=cmmarin/student-id-credential-service:lab5-1.7.3@sha256:7db57ce43ef93a209f182a505c2cf48f00c9ead9d6111cdc54dbc2bc2314a5e4
OWNED_RULES_IMAGE=cmmarin/student-id-rules-service:lab5-1.6.2@sha256:6ea60d1197f7cfc2cae5b9250c0e68de578d7f396cf031c93f3c83b2307e61b6
# The opt-in overlay requires gRPC for these two owned services; rolling back
# requires a coordinated deployment/catalog change, never silent HTTP fallback.
CREDENTIAL_BROKER_SERVICE_TOKEN=
RULES_BROKER_SERVICE_TOKEN=
# Moderation and Discord DMs use the published gRPC releases verified below.
OWNED_MODERATION_VERSION=lab3-0.13.2@sha256:82d648fe90549d31ef3260e2c84eab06eb4e0680b71c68b680bef08b119d3a52
OWNED_DMS_VERSION=lab3-0.13.0@sha256:e34438ec4b97e14b0ddd2f8bb8ae083f028ca9bf24436e7b91dae7612e6413d7

# Each caller token is distinct from every target/management/Discovery credential.
# The JSON map must contain applicant-service and university-record-service with
# exactly the respective caller values below, plus any actual peer callers.
BROKER_CALLER_TOKENS_JSON=
APPLICANT_BROKER_SERVICE_TOKEN=
RECORD_BROKER_SERVICE_TOKEN=
# Moderation's and DMs' own caller credentials; BROKER_CALLER_TOKENS_JSON must map
# moderation-service and discord-dms-service to exactly these values.
MODERATION_BROKER_SERVICE_TOKEN=
DMS_BROKER_SERVICE_TOKEN=
APPLICANT_INTERNAL_TOKEN=
RECORD_INTERNAL_TOKEN=
CREDENTIAL_INTERNAL_TOKEN=
SESSION_INTERNAL_TOKEN=
APPLICANT_MANAGEMENT_TOKEN=
RECORD_MANAGEMENT_TOKEN=

# Public JWTs stop at Gateway. The Broker owns all target credentials; the new
# subscriber-queue Gateway does not use GATEWAY_TARGET_TOKENS_JSON.

# Receiver credentials. Moderation and DMs are required with this overlay; the Broker
# presents them on gRPC deliveries and the services check them. Discord DMs also needs
# GATEWAY_JWT_PUBLIC_KEY_B64 from .env (the Player public key).
MODERATION_INTERNAL_TOKEN=
DMS_INTERNAL_TOKEN=
# Required Rules and Player receivers in the full Lab 4 overlay.
RULES_INTERNAL_TOKEN=
PLAYER_INTERNAL_TOKEN=

# Gateway subscriber queues, Player signing and Player/Session gRPC messaging.
# Published tags and immutable digests checked on 2026-11-26.
OWNED_GATEWAY_IMAGE=vasiok11/student-id-gateway-service:lab4-2.1.1-build.59@sha256:1313c55b1295bb96c204025be0364dc6ed0dbb95555cd8e6b9ad78a916b1de5c
OWNED_PLAYER_IMAGE=vasiok11/student-id-player-service:lab5-1.8.0-build.50@sha256:89bc6b93c6033e18c8d624b0ca37fa0ebae2434cebd797ea5bcb903ebc926efc
OWNED_SESSION_IMAGE=vasiok11/student-id-session-service:lab5-1.8.0-build.56@sha256:20950f4fccfe58ff1d8fb4e71c1eea1e7e5bdb42fb4bc694c17dced562fe2fb4
GATEWAY_BROKER_SERVICE_TOKEN=
PLAYER_BROKER_SERVICE_TOKEN=
SESSION_BROKER_SERVICE_TOKEN=
# Locally generated PKCS#8 RSA private key, base64 encoded. Never export/commit it.
# GATEWAY_JWT_PUBLIC_KEY_B64 must contain its matching public key.
PLAYER_JWT_PRIVATE_KEY_B64=
# Include gateway-service and all eight service callers in BROKER_CALLER_TOKENS_JSON,
# each mapped to its distinct *_BROKER_SERVICE_TOKEN above.

# Optional Task 10 monitoring overlay: set privately before enabling it.
# These image selections do not enable the optional monitoring overlay.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Published releases include Task 10 load telemetry.
TASK10_BROKER_IMAGE=andreiisthebest/student-id-message-broker:lab4-0.9.0@sha256:4eae9c3d4d0bfb5c730b27416daee095d4a74ae68bdfd3710d2588cbb711e163
TASK10_CREDENTIAL_IMAGE=cmmarin/student-id-credential-service:lab5-1.7.3@sha256:7db57ce43ef93a209f182a505c2cf48f00c9ead9d6111cdc54dbc2bc2314a5e4
TASK10_RULES_IMAGE=cmmarin/student-id-rules-service:lab5-1.6.2@sha256:6ea60d1197f7cfc2cae5b9250c0e68de578d7f396cf031c93f3c83b2307e61b6
