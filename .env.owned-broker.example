# Add these to a PRIVATE deployment environment when selecting the opt-in overlay.
# All image values must identify the migrated source, never old latest tags.
# Expected release tags below are rollout targets, not a claim of publication.
# Merge/release Applicant PR #30 and Record PR #32; verify images before deployment.
OWNED_APPLICANT_IMAGE=andreiisthebest/student-id-applicant-service:lab3-1.2.0
OWNED_RECORD_IMAGE=andreiisthebest/student-id-university-record-service:lab3-1.2.0
# Moderation/DMs lab3-0.8.0 publish over gRPC: the Broker image must serve gRPC
# (andreiisthebest/student-id-message-broker:lab4-0.6.0 or later, once released).
# Must bundle applicant-service=grpc and university-record-service=grpc.
# Existing lab4-0.6.0 supports gRPC but still bundles HTTP delivery for these groups.
# Select the reviewed 0.6.2+ release (or immutable digest) after the paired rollout PR.
OWNED_BROKER_IMAGE=
# Credential/Rules gRPC-capable releases. Verify publication/source labels before use.
OWNED_CREDENTIAL_IMAGE=cmmarin/student-id-credential-service:lab4-1.1.0
OWNED_RULES_IMAGE=cmmarin/student-id-rules-service:lab4-1.1.0
# Safe defaults: enable listeners first, verify standard gRPC health and actual
# peer scenarios, then activate each reviewed transport independently.
OWNED_CREDENTIAL_GRPC_ENABLED=false
OWNED_RULES_GRPC_ENABLED=false
OWNED_CREDENTIAL_BROKER_TRANSPORT=http
OWNED_RULES_BROKER_TRANSPORT=http
CREDENTIAL_BROKER_SERVICE_TOKEN=
RULES_BROKER_SERVICE_TOKEN=
# Moderation and Discord DMs: the reviewed lab3-0.8.0 releases (gRPC to the Broker) are
# the defaults; override only with another published, reviewed tag.
# Published 12 Nov 2026: moderation sha256:2d539f5ce3f2f067c05ebff3c325bd11209e28eebf8cff51ff2fd30ec288246c,
# dms sha256:dcd893cc6615783927c8aea0c4bdab7c309d59d15d4e1765338cc6e901c98d3f.
OWNED_MODERATION_VERSION=lab3-0.8.0
OWNED_DMS_VERSION=lab3-0.8.0

# Each caller token is distinct from every target/management/Discovery credential.
# The JSON map must contain applicant-service and university-record-service with
# exactly the respective caller values below, plus any actual peer callers.
BROKER_CALLER_TOKENS_JSON=
APPLICANT_BROKER_SERVICE_TOKEN=
RECORD_BROKER_SERVICE_TOKEN=
# Moderation's and DMs' own caller credentials; BROKER_CALLER_TOKENS_JSON must map
# moderation-service and discord-dms-service to exactly these values.
MODERATION_BROKER_SERVICE_TOKEN=
DMS_BROKER_SERVICE_TOKEN=
APPLICANT_INTERNAL_TOKEN=
RECORD_INTERNAL_TOKEN=
CREDENTIAL_INTERNAL_TOKEN=
SESSION_INTERNAL_TOKEN=
APPLICANT_MANAGEMENT_TOKEN=
RECORD_MANAGEMENT_TOKEN=

# Public Gateway receivers, including Record's receiver credential. This map is
# separate from broker caller identities; retain all needed public receiver entries.
GATEWAY_TARGET_TOKENS_JSON=

# Receiver credentials. Moderation and DMs are required with this overlay; the Broker
# presents them on gRPC deliveries and the services check them. Discord DMs also needs
# GATEWAY_JWT_PUBLIC_KEY_B64 from .env (the Player public key).
MODERATION_INTERNAL_TOKEN=
DMS_INTERNAL_TOKEN=
# Optional additional receivers when those real peer paths are enabled.
RULES_INTERNAL_TOKEN=
PLAYER_INTERNAL_TOKEN=
