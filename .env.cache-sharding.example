# Lab 5 cache sharding (docker-compose.cache-sharding.yml, used instead of
# docker-compose.cache.yml). Add to the same ignored private .env; never commit real values.

# Moderation's cache nodes: 16+ characters, never reused.
MODERATION_CACHE_PASSWORD=
# DMs' cache nodes: 32-256 characters, never reused.
DMS_MEMBERSHIP_CACHE_PASSWORD=

# Service versions with the consistent-hash ring. Lab 5 releases are cumulative, so with
# docker-compose.replication.yml use the same versions for REPLICATION_*_VERSION as well.
SHARDING_MODERATION_VERSION=lab3-0.13.0
SHARDING_DMS_VERSION=lab3-0.13.0

# Optional (these are the defaults): points per node on the ring.
# CACHE_VNODES=160
